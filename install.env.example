# Copy this OUTSIDE the repository and fill in. Keeping it in the checkout means a
# re-clone deletes it, and putting the values in install.sh means a git pull can
# conflict with them.
#
#   mkdir -p ~/.config/opencode-telegram-installer
#   cp install.env.example ~/.config/opencode-telegram-installer/install.env
#   $EDITOR ~/.config/opencode-telegram-installer/install.env
#   ./install.sh
#
# Or skip the file and pass values for a single run:
#
#   TELEGRAM_BOT_TOKEN=... ./install.sh
#
# Anything exported in the shell wins over this file, so a one-off override does not
# mean editing it. See README.md "Settings and credentials".

TELEGRAM_BOT_TOKEN=
# Every id here gets the standard policy: its own workspace, and the social-media agent.
# An id in neither this list nor TELEGRAM_ADMIN_USER_IDS is denied outright.
TELEGRAM_ALLOWED_USER_ID=
# Ids that get the admin policy. They can reach any workspace, use any agent, run the
# admin-only commands and manage MCP connections. Keep this short: an admin is trusted with
# everything the Linux user running the bot can do.
TELEGRAM_ADMIN_USER_IDS=
CF_WORKERS_AI_ACCOUNT=
CF_WORKERS_AI_TOKEN=

# Optional. Leave both empty to skip Postiz; setting only one is rejected.
POSTIZ_MCP_URL=
POSTIZ_MCP_TOKEN=

# Model used by the agent.
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=space-bunny-free

# How much markup a social post body may carry.
#   strict (default) - social platforms get plain text with no tags at all, so no
#                      <em> or <strong> to stress a word; article targets such as
#                      WordPress may still use <p> for the image-in-paragraph rule
#   html             - allow markup on every platform
# Leave this alone unless you want markup everywhere. postiz_check_post enforces
# it per platform either way.
POSTIZ_CONTENT_FORMAT=strict

# Where updates come from. Point these at your own fork if you have one.
PAYLOAD_REPO=jiqiri/opencode-telegram-installer
PAYLOAD_BRANCH=main
